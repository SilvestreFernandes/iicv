{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        "node_modules/@playwright/mcp/cli.js",
        "--browser",
        "chromium",
        "--headless",
        "--isolated",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
