{
  "outputStyle": "Enxuto",
  "enabledMcpjsonServers": ["playwright"],
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm view *)",
      "Bash(npm audit)",
      "Bash(npm audit *)",
      "Bash(npm run *)",
      "Bash(node .claude/skills/comecar/scripts/ffmpeg.mjs *)",
      "Bash(npx playwright install chromium)",
      "Bash(npx lighthouse *)",
      "Bash(bash .claude/skills/seguranca-web/scripts/scan_segredos.sh .)",
      "Bash(node .claude/skills/comecar/scripts/enderecos.mjs)",
      "Bash(node .claude/skills/comecar/scripts/marco.mjs *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "mcp__playwright"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "PowerShell(git push *)",
      "PowerShell(git * push *)",
      "Bash(npx vercel *)"
    ],
    "deny": [
      "Read(./.env*)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(find * -delete)",
      "Bash(find * -exec rm *)",
      "Bash(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force*)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rmdir *)",
      "PowerShell(rd *)",
      "PowerShell(del *)",
      "PowerShell(format *)"
    ]
  }
}
